IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "reset" 88;
IO_PORT "reset" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// UART
IO_LOC "uart_txp" 69;
IO_PORT "uart_txp" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

// Onboard LEDs
IO_LOC "led[0]" 15;
IO_LOC "led[1]" 16;
IO_LOC "led[2]" 17;
IO_LOC "led[3]" 18;
IO_LOC "led[4]" 19;
IO_LOC "led[5]" 20;

IO_PORT "led[0]" IO_TYPE=LVCMOS33;
IO_PORT "led[1]" IO_TYPE=LVCMOS33;
IO_PORT "led[2]" IO_TYPE=LVCMOS33;
IO_PORT "led[3]" IO_TYPE=LVCMOS33;
IO_PORT "led[4]" IO_TYPE=LVCMOS33;
IO_PORT "led[5]" IO_TYPE=LVCMOS33;

// HDMI Data Channel 0
IO_LOC "TMDSp[0]" 35,36;
IO_PORT "TMDSp[0]" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5;

// HDMI Data Channel 1
IO_LOC "TMDSp[1]" 37,38;
IO_PORT "TMDSp[1]" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5;

// HDMI Data Channel 2
IO_LOC "TMDSp[2]" 39,40;
IO_PORT "TMDSp[2]" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5;

// HDMI Clock
IO_LOC "TMDSp_clock" 33,34;
IO_PORT "TMDSp_clock" IO_TYPE=LVDS25 PULL_MODE=NONE DRIVE=3.5;

